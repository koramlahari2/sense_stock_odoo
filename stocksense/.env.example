# =========================================================
# FIREBASE - CLIENT/WEB CONFIG (used for email/password auth)
# Get these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# These are safe-ish (public) but still keep them out of git via .env
# =========================================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# =========================================================
# FIREBASE - SERVER/ADMIN CONFIG (used for Firestore Admin SDK)
# Download from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# This JSON file is a FULL BACKEND CREDENTIAL. Never commit it. Keep it in /secrets (gitignored).
# =========================================================
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# =========================================================
# AI PROVIDER (server-side only, never used in any client-visible code)
# Set AI_PROVIDER to "gemini" or "grok"
# =========================================================
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
XAI_API_KEY=
